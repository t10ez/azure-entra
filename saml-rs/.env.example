# Entra admin center > Overview
TENANT_ID=<tenant-id>

# Enterprise app > Single sign-on > SAML
# Identifier (Entity ID); Reply URL must be http://localhost:4000/auth/saml/acs
SAML_ENTITY_ID=CDLS_PRD
# Certificate (Base64) file path, PEM, or bare base64 ...
ENTRA_SAML_CERT=./entra-saml.cer
# ... or App Federation Metadata Url instead of the cert
SAML_IDP_METADATA_URL=

PORT=4000
